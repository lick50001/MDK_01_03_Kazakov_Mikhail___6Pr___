<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Поисковая строка -->
    <EditText
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:hint="Поиск"
        android:background="@drawable/background_search"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <!-- Заголовок "Категории" -->
    <TextView
        android:id="@+id/tv_categories_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Категории"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#1A1A1A"
        app:layout_constraintTop_toBottomOf="@+id/search_bar" />

    <!-- Категории (горизонтальный список) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/category_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tv_categories_title"
        android:layout_marginTop="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="horizontal" />

    <!-- Заголовок "Популярное" -->
    <TextView
        android:id="@+id/tv_popular_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Популярное"
        android:textSize="22sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        app:layout_constraintTop_toBottomOf="@+id/category_list" />

    <!-- Товары -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/card_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tv_popular_title"
        app:layout_constraintBottom_toTopOf="@id/navigation_bar"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Навигационная панель -->
    <include
        layout="@layout/fragment_menu_navigation"
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>